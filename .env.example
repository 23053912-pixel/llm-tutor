# LLM Tutor - Environment Variables Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to Git (it's in .gitignore)

# ============================================================================
# REQUIRED: Groq API Configuration
# ============================================================================
# Get your API key from: https://console.groq.com/keys
# Format: Must start with "gsk_"
GROQ_API_KEY=gsk_your_actual_key_here_replace_this

# ============================================================================
# OPTIONAL: Streamlit Configuration
# ============================================================================
# Primary UI color (hex format)
STREAMLIT_CONFIG_THEME_PRIMARYCOLOR=#FF6B35

# Text color
STREAMLIT_CONFIG_THEME_TEXTCOLOR=#000000

# Font family
STREAMLIT_CONFIG_THEME_FONT=sans serif

# ============================================================================
# OPTIONAL: ChromaDB Configuration
# ============================================================================
# Name of the collection to store embeddings
CHROMADB_COLLECTION_NAME=llm_tutor_docs

# Distance metric for vector similarity: cosine | l2 | ip
CHROMADB_DISTANCE_METRIC=cosine

# ============================================================================
# OPTIONAL: Agent Configuration
# ============================================================================
# Directory to save conversation memory state
MEMORY_SAVE_DIR=./memory_state

# Number of previous messages to keep in context
MAX_CONTEXT_MESSAGES=6

# Minimum faithfulness score before triggering retry (0.0 - 1.0)
MIN_FAITHFULNESS_SCORE=0.8

# Maximum number of retries for low-quality responses
EVALUATION_RETRIES=2

# ============================================================================
# OPTIONAL: Logging Configuration
# ============================================================================
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# NOTES
# ============================================================================
# 1. All OPTIONAL variables have sensible defaults if not set
# 2. Only GROQ_API_KEY is truly required to run the application
# 3. For development, set LOG_LEVEL=DEBUG for detailed output
# 4. For production, use LOG_LEVEL=INFO or WARNING
# 5. Never share your .env file or GROQ_API_KEY with others
# 6. Use GitHub Secrets if deploying to Streamlit Cloud or other platforms
# 7. Rotate your API key regularly via https://console.groq.com
